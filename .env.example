# Postgres (see docker-compose.yml — run: pnpm db:up)
DATABASE_URL=postgresql://username:password@localhost:5432/database_name

# Better Auth — generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=your_secret_key
BETTER_AUTH_URL=http://localhost:4000
# From https://dash.better-auth.com — required for Infrastructure dashboard
BETTER_AUTH_API_KEY=your_api_key

# Telegram OIDC (BotFather → Bot Settings → Web Login → OpenID Connect)
TELEGRAM_OIDC_CLIENT_ID=your_client_id
TELEGRAM_OIDC_CLIENT_SECRET=your_client_secret

# ngrok — run on host (recommended): pnpm ngrok:up
# Requires ngrok CLI: https://ngrok.com/download
# Then once: ngrok config add-authtoken <your-token>
NGROK_AUTHTOKEN=your_authtoken
NGROK_DOMAIN=your_domain

# Alternative: pnpm ngrok:docker (ngrok in Docker — needs Vite host: true, less reliable on Windows)

# When testing via ngrok (Telegram OIDC), keep NGROK_DOMAIN set — the API
# automatically trusts https://<NGROK_DOMAIN> and uses it as BETTER_AUTH_URL.
# BotFather redirect URL:
#   https://<NGROK_DOMAIN>/api/auth/callback/telegram-oidc
# Optional Vite HMR over ngrok: NGROK_HMR=true and NGROK_HOST=<NGROK_DOMAIN>

# API
CORS_ORIGIN=http://localhost:3000
PORT=4000
